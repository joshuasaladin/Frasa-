# Supabase project (Settings -> API). For local development, `npm run db:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for inviting users and the optional HTTP cron route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the app, used in invitation links.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional: enables POST /api/cron/run-jobs for an external scheduler (not needed when pg_cron is used).
CRON_SECRET=
